{
  // markdownlint 的默认行宽是 80 字符。正文与代码块都按此宽度折行，
  // 但表格单元格在 Markdown 里无法折行，本项目的若干说明列较长，
  // 因此只对表格行取消行宽限制。
  "MD013": {
    "line_length": 80,
    "tables": false
  },

  // 表格一律采用紧凑写法：单元格与竖线之间只留一个空格，不做对齐填充。
  //
  // 原因：markdownlint 按字符数计算列宽，而一个汉字在编辑器中占两个字符宽。
  // 按显示宽度补齐的表格（| 项目       | 要求     |）在它看来每行竖线位置
  // 都不一致，必然报 MD060；改成按字符数补齐，屏幕上反而是歪的。
  // 两者不可兼得，故固定为紧凑写法，今后修改单元格无需重排整张表。
  "MD060": {
    "style": "compact"
  }
}
